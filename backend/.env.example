# ---- Servidor ----
# Si el 4000 esta ocupado por otra app, cambie este valor y VITE_PROXY_TARGET
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# URL del frontend que se envia en los mensajes de WhatsApp
APP_URL=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bingodgg
DB_CONNECTION_LIMIT=10

# ---- JWT ----
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# ---- Administrador inicial (npm run seed:admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!

# ---- WhatsApp (Baileys) ----
# El chatbot queda DESCONECTADO: los cartones los manda el vendedor desde su
# propio WhatsApp (enlace wa.me). Poner true solo para reactivar el chatbot.
WA_ENABLED=false
WA_SESSION_FILE=./session.json
WA_PRINT_QR=true

# ---- Uploads (multer) ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
